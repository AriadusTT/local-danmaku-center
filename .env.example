# Emby 连接默认值（可选）
# 正常使用不需要填这里 —— 在网页「设置」里填一次就会存进数据库，重启不丢。
# 这里只是给「完全不想开网页」的场景留的兜底默认值。
#
# EMBY_BASE_URL=http://192.168.1.10:8096
# EMBY_API_KEY=

# HTTP 服务（只监听本机；需要局域网访问改成 0.0.0.0）
APP_HOST=127.0.0.1
APP_PORT=8000

# 存储
DB_PATH=./data/app.db
REQUEST_TIMEOUT=30

# 扫描默认值（同样可在网页「设置」里改，改完以数据库为准）
PAGE_SIZE=500
SCHEDULER_ENABLED=true
SCAN_CRON_INCREMENTAL=0 3 * * *
SCAN_CRON_FULL=0 3 * * 0
